{
  "expo": {
    "name": "Pawpaw Ko",
    "slug": "pawpawko-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pawpawkomobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.pawpawko.app"
    },
    "android": {
      "package": "com.pawpawko.app",
      "adaptiveIcon": {
        "backgroundColor": "#181622",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#181622",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 140
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pawpaw Ko shows you trade binders from other users nearby when Auto-Search is on."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.132449239636-prjaaehu0und1bpts6btsml7akujp4nr"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ac26976e-95f7-4397-858c-3f9b4c68d158"
      }
    },
    "owner": "pawpawko"
  }
}
